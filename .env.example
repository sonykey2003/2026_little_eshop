# ---------------------------------------------------------------------------
# Copy this file to ".env" and edit it. Never commit your .env file.
#
#     cp .env.example .env
# ---------------------------------------------------------------------------


# --- Make the shop yours -------------------------------------------------
SHOP_NAME="The Little Phuket Shop"
SHOP_TAGLINE="Nice things, fair prices"
CURRENCY_SYMBOL="B"


# --- Database ------------------------------------------------------------
# These three are used by both the database and the web app.
# The defaults are fine for a workshop laptop.
POSTGRES_DB=shop
POSTGRES_USER=shopkeeper
POSTGRES_PASSWORD=change-me-before-you-deploy-anywhere-real


# --- Flask ---------------------------------------------------------------
# Signs the cookie that remembers your shopping cart.
# Any long random string will do. Change it.
SECRET_KEY=please-change-this-to-a-long-random-string


# --- Optional AI assistant -----------------------------------------------
# Leave AI_API_KEY empty and the chat button simply will not appear.
# To switch it on, uncomment ONE of the two blocks below and paste your key.

AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Option 1 - NVIDIA NIM        (free key: https://build.nvidia.com/)
# AI_API_KEY=nvapi-paste-your-key-here
# AI_BASE_URL=https://integrate.api.nvidia.com/v1
# AI_MODEL=meta/llama-3.1-8b-instruct

# Option 2 - OpenRouter        (free key: https://openrouter.ai/)
# AI_API_KEY=sk-or-paste-your-key-here
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=meta-llama/llama-3.1-8b-instruct:free
